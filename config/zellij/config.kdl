// Ctrl+g odblokowuje skróty Zellij; ponowne Ctrl+g wraca do pracy w aplikacji.
// Domyślne skróty i pasek podpowiedzi pozostają dostępne po odblokowaniu.
default_mode "locked"
default_shell "fish"
theme "catppuccin-mocha"
mouse_mode true
pane_frames true
scroll_buffer_size 10000
copy_on_select false
// Nie zapisuj zawartości terminala na dysku do odtwarzania sesji.
session_serialization false
